# Real messages can contain names, numbers and account details. Keep them out of git by default.
eval/data/*
!eval/data/.gitkeep
eval/results/
docs/testing/test-observations.md

# macOS folder files
.DS_Store

# ML experiment: Python environment, downloaded data and results stay on this computer
.venv-ml/
ml/data/
ml/results/

# Local dependencies and browser-test output
node_modules/
test-results/
playwright-report/
experiments/ocr-robustness/out/
experiments/help-search/out/

# Robustness run output. The report is regenerated from the frozen generator, so it is not
# source; commit a single dated copy if a judge-facing number needs to live in the repo.
adversarial/results/

# Discovery tool: reports, review exports and embedding caches hold message text or vectors derived
# from it (not anonymous). Only code, docs and fictional fixtures under discovery/ are tracked.
discovery/out/
discovery/.cache/
discovery/**/review-*.json
